# ─────────────────────────────────────────────────────────────────────────────
# НИКА — единый шаблон переменных окружения.
# Скопируй в `.env` и заполни значениями. В проде (Railway) задай те же ключи
# в переменных сервиса. NEXT_PUBLIC_* — build-time: меняются только пересборкой.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>          # серверный ключ, в браузер НЕ попадает
SUPABASE_ACCESS_TOKEN=<management-token>              # опционально: Supabase CLI/миграции

# ── Anthropic (генерация текстов НИКИ) ───────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Robokassa (приём оплат) ──────────────────────────────────────────────────
ROBOKASSA_MERCHANT_LOGIN=<merchant-login>
ROBOKASSA_PASSWORD_1=<password-1>
ROBOKASSA_PASSWORD_2=<password-2>
ROBOKASSA_IS_TEST=0                                   # 1 = тестовый режим (тестовые пароли)
ROBOKASSA_FISCALIZATION=1                             # 1 = слать чек (54-ФЗ)
ROBOKASSA_SNO=usn_income                              # система налогообложения
ROBOKASSA_TAX=none                                    # ставка НДС в позиции чека
ROBOKASSA_HASH_ALGO=md5                               # ДОЛЖЕН совпадать с кабинетом Robokassa
ROBOKASSA_DEBUG=0

# ── Telegram-бот уведомлений (@mynikarun_bot) ────────────────────────────────
# Один экземпляр (lib/telegram/bot.ts): локально `npm run bot:dev` (polling),
# в проде — webhook /api/telegram/webhook. Отдельного bot/ больше нет.
TELEGRAM_BOT_TOKEN=<botfather-token>
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=mynikarun_bot       # build-time! нужен для deep-link привязки
TELEGRAM_WEBHOOK_SECRET=<random-hex>                  # то же значение в проде; сверяется в webhook
CRON_SECRET=<random-hex>                              # защита /api/cron/* и set-webhook; то же в проде
ADMIN_SECRET=<random-hex>                             # вход в /admin/* и команда /admin <ключ> в боте (опрос про погоду)

# ── Внутренний бот команды ───────────────────────────────────────────────────
# ДРУГОЙ бот в BotFather, не тот, что выше. «Пятница» (lib/team/bot.ts): задачи,
# расписание, ивенты клубов, команда, FAQ и сводка дня.
# Участникам не пишет ничего — рассылки остались за основным ботом.
# Локально `npm run team:dev` (polling), в проде — webhook
# /api/telegram/team-webhook, регистрируется сам при старте приложения.
# Переменных нет → командного бота в этом окружении просто нет, приложение
# поднимается как обычно.
TEAM_BOT_TOKEN=<botfather-token>                      # токен ВТОРОГО бота
TEAM_WEBHOOK_SECRET=<random-hex>                      # свой, НЕ равный TELEGRAM_WEBHOOK_SECRET
TEAM_BOT_SECRET=<random-hex>                          # разовый ключ входа: /join <ключ>
TEAM_FOUNDER_IDS=                                    # Telegram ID фаундеров через запятую: /kick, правка любого события, исправление явки

# ── Бот данных команды («Цифры команды») ─────────────────────────────────────
# ТРЕТИЙ бот в BotFather. Отвечает сотрудникам цифрами из базы по зонам
# доступа (lib/databot). Локально `npm run databot:dev` (polling, токен
# ТЕСТОВОГО бота), в проде — webhook /api/telegram/databot-webhook,
# регистрируется сам при старте. Нет DATABOT_TOKEN → бота в окружении нет.
DATABOT_TOKEN=                                        # токен бота; локально — тестового, боевой только в Railway
DATABOT_WEBHOOK_SECRET=                               # свой, НЕ равный TELEGRAM_WEBHOOK_SECRET и TEAM_WEBHOOK_SECRET
DATABOT_OWNER_IDS=                                    # chat_id владельцев через запятую; узнать — npm run databot:dev
DATABOT_TASK_CHAT_ID=                                 # ID одной разрешённой супергруппы с топиками; отрицательное число -100…
DATABOT_TASK_SOURCE_THREAD_IDS=                       # message_thread_id топиков исходных задач через запятую
DATABOT_TASK_WORK_THREAD_ID=                          # необязательно: единый рабочий топик; пусто = топик исходной задачи
# Боту нужны права администратора на публикацию и закрепление, а также выключенный
# privacy mode в BotFather для получения сообщений и событий закрепления.
# ID видны в апдейте message.chat.id/message.message_thread_id и в логах databot:dev.
DATABOT_LLM=                                          # on — модель помогает выбрать отчёт; по умолчанию off
DATABOT_LLM_MODEL=                                    # имя быстрой дешёвой модели для разбора вопроса

# ── Web-push (VAPID) ─────────────────────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=<vapid-public-key>       # build-time! нужен клиенту для подписки
VAPID_PRIVATE_KEY=<vapid-private-key>
VAPID_EMAIL=mailto:ceo@mynika.ru

# ── Общее ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://www.mynika.online         # базовый URL: deep-link, webhook, ссылки
